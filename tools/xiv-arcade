def ff_keys(title: str, system: str) -> list[str]:
    """Which shelf entries a game lights up. A compilation lights up each game in it. On the SNES the
    American "Final Fantasy II" and "III" are IV and VI: the Super Famicom never had a II or a III."""
    n = normalize(title)
    if system == "snes":
        n = re.sub(r"^final fantasy 2$", "final fantasy 4", n)
        n = re.sub(r"^final fantasy 3$", "final fantasy 6", n)
    return [e.key for e in FF_SHELF if any(re.search(p, n) for p in e.patterns)]


# --------------------------------------------------------------------------------------------
# Fuzzy matching
# --------------------------------------------------------------------------------------------

def fuzzy_score(text: str, query: str) -> float | None:
    """None when the query's characters do not appear in order. Roman numerals and digits match each
    other ("ff7", "final fantasy vii"); word starts and runs score higher; a full match scores highest."""
    t = normalize(text)
    q = " ".join("ff" + _ROMAN.get(m.group(1), m.group(1)) + m.group(2) if (m := re.fullmatch(r"ff([ivx]+)(\d*)", w)) else w
                 for w in normalize(query).split())
    if not q:
        return 0.0
    initials = "".join(w[0] if not w.isdigit() else w for w in t.split())
    if q.replace(" ", "") == initials:
        return 900.0
    if t == q:
        return 1000.0
    if q in t:
        return 800.0 - t.index(q) - (len(t) - len(q)) * 0.5
    qc = q.replace(" ", "")
    if initials.startswith(qc):
        return 700.0 - len(initials)
    score, pos, run = 0.0, 0, 0
    for ch in qc:
        i = t.find(ch, pos)
        if i < 0:
            return None
        start = i == 0 or t[i - 1] == " "
        run = run + 1 if i == pos and pos > 0 else 0
        score += 10 + (15 if start else 0) + run * 5
        pos = i + 1
    return score - len(t) * 0.25


def fuzzy_pick(games: list[dict], query: str) -> dict | None:
    best, best_score = None, None
    for g in games:
        s = fuzzy_score(g["title"], query)
        if s is None:
            continue
        s += 5 if g.get("ff") else 0
        if best_score is None or s > best_score:
            best, best_score = g, s
    return best


