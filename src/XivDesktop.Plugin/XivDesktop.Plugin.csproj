<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>XivDesktop</AssemblyName>
    <RootNamespace>XivDesktop.Plugin</RootNamespace>
    <Version>1.0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XivDesktop.Core\XivDesktop.Core.csproj" />
    <Compile Include="..\Shared\IpcContract.cs" Link="Shared\IpcContract.cs" />
    <Compile Include="..\Shared\GameCursor.cs" Link="Shared\GameCursor.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The arcade's host helper travels inside the DLL; the plugin writes it to ~/.config/xiv-arcade/ on the host. -->
    <EmbeddedResource Include="..\..\tools\xiv-arcade" LogicalName="xiv-arcade" />
  </ItemGroup>
  <ItemGroup>
    <!-- Native (AtkUnitBase) dialogue and picker for Ask an NPC. MIT, github.com/MidoriKami/KamiToolKit; built for Dalamud API 15. -->
    <PackageReference Include="KamiToolKit" Version="2.2.48" />
  </ItemGroup>
</Project>
